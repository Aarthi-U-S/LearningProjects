# Database Configuration
ConnectionStrings__DefaultConnection=Server=(localdb)\\Mydb;Database=LearningDB;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Configuration
# IMPORTANT: Change this secret key in production! Minimum 32 characters
Jwt__SecretKey=YourSuperSecretKeyThatIsAtLeast32CharactersLong!ChangeThisInProduction
Jwt__Issuer=AuthAPI
Jwt__Audience=AuthAPIClient
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
